DATABASE_URL=postgres://postgres:postgres@localhost:<docker-mapped-port>/cherelynnandkevin
NODE_ENV=development
VITE_API_PROXY_TARGET=https://api.cherelynnandkevin.localhost

# Guest list and RSVP persistence live in Postgres (guests table + seed).
# No Google Sheets or Apps Script runtime configuration remains.

# Hidden admin surface (/admin/guests + /admin/* APIs). Empty/missing means
# the admin endpoints stay disabled (503/401, fail-closed). Set a long random
# secret (generate with `openssl rand -hex 32`) in the server environment
# only; it is never exposed to the frontend build.
ADMIN_PASSWORD=your-admin-password
